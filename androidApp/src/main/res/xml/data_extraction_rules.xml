<?xml version="1.0" encoding="utf-8"?>
<!--
  android:allowBackup="false" already disables cloud backup, but on API 31+ it
  does NOT disable device-to-device transfer; that needs an explicit exclude.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
    </device-transfer>
</data-extraction-rules>
