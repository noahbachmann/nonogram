CREATE TABLE NonogramData (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    difficulty TEXT NOT NULL,
    solution TEXT NOT NULL
);

CREATE TABLE User (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    firebaseUid TEXT
);

CREATE UNIQUE INDEX idx_user_firebaseUid ON User(firebaseUid);

CREATE TABLE UserProgress (
    userId INTEGER NOT NULL,
    nonogramId INTEGER NOT NULL,
    boardState TEXT,
    updatedAt INTEGER NOT NULL,
    PRIMARY KEY (userId, nonogramId),
    FOREIGN KEY (userId) REFERENCES User(id),
    FOREIGN KEY (nonogramId) REFERENCES NonogramData(id)
);

insertNonogram:
INSERT INTO NonogramData(id, difficulty, solution) VALUES (NULL, ?, ?);

selectAllNonograms:
SELECT NonogramData.* FROM NonogramData;

selectNonogramsByDifficulty:
SELECT NonogramData.* FROM NonogramData WHERE difficulty = ?;

selectNonogramById:
SELECT NonogramData.* FROM NonogramData WHERE id = ?;

selectRandomNonogram:
SELECT NonogramData.* FROM NonogramData ORDER BY RANDOM() LIMIT 1;

selectRandomNonogramByDifficulty:
SELECT NonogramData.* FROM NonogramData WHERE difficulty = ? ORDER BY RANDOM() LIMIT 1;

upsertProgress:
INSERT OR REPLACE INTO UserProgress(userId, nonogramId, boardState, updatedAt)
VALUES (?, ?, ?, ?);

selectProgressForUser:
SELECT NonogramData.*, UserProgress.boardState
FROM NonogramData
JOIN UserProgress ON UserProgress.nonogramId = NonogramData.id
WHERE UserProgress.userId = ?;

insertUser:
INSERT INTO User(id, name) VALUES (NULL, ?);

lastInsertedId:
SELECT last_insert_rowid();

selectUserById:
SELECT User.* FROM User WHERE id = ?;

selectUserByFirebaseUid:
SELECT User.* FROM User WHERE firebaseUid = ?;

updateUserFirebaseUid:
UPDATE User SET firebaseUid = ?, name = ? WHERE id = ?;

selectProgressForUserWithTimestamp:
SELECT UserProgress.nonogramId, UserProgress.boardState, UserProgress.updatedAt
FROM UserProgress
WHERE UserProgress.userId = ?;

selectSingleProgress:
SELECT UserProgress.boardState, UserProgress.updatedAt
FROM UserProgress
WHERE UserProgress.userId = ? AND UserProgress.nonogramId = ?;