CREATE TABLE NonogramData (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    difficulty TEXT NOT NULL,
    solution TEXT NOT NULL,
    authorUid TEXT NOT NULL DEFAULT '',
    status INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    name TEXT
);

CREATE TABLE User (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    firebaseUid TEXT
);

CREATE UNIQUE INDEX idx_user_firebaseUid ON User(firebaseUid);

CREATE TABLE UserProgress (
    userId INTEGER NOT NULL,
    nonogramId INTEGER NOT NULL,
    boardState TEXT,
    updatedAt INTEGER NOT NULL,
    beat INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (userId, nonogramId),
    FOREIGN KEY (userId) REFERENCES User(id),
    FOREIGN KEY (nonogramId) REFERENCES NonogramData(id)
);

upsertNonogram:
INSERT OR REPLACE INTO NonogramData(id, difficulty, solution, authorUid, status, updatedAt, name)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateNonogram:
UPDATE NonogramData
SET
    difficulty = :difficulty,
    solution = :solution,
    authorUid = :authorUid,
    status = :status,
    updatedAt = :updatedAt,
    name = :name
WHERE id = :id;


selectAllNonograms:
SELECT NonogramData.* FROM NonogramData;

selectNonogramsByDifficulty:
SELECT NonogramData.* FROM NonogramData WHERE difficulty = ?;

selectNonogramsByAuthor:
SELECT NonogramData.* FROM NonogramData WHERE authorUid = ?;

reassignAuthor:
UPDATE NonogramData SET authorUid = :toUid WHERE authorUid = :fromUid;

selectNonogramById:
SELECT NonogramData.* FROM NonogramData WHERE id = ?;

selectRandomNonogram:
SELECT NonogramData.* FROM NonogramData ORDER BY RANDOM() LIMIT 1;

selectRandomNonogramByDifficulty:
SELECT NonogramData.* FROM NonogramData WHERE difficulty = ? ORDER BY RANDOM() LIMIT 1;

upsertProgress:
INSERT OR REPLACE INTO UserProgress(userId, nonogramId, boardState, updatedAt, beat)
VALUES (:userId, :nonogramId, :boardState, :updatedAt, COALESCE((SELECT beat FROM UserProgress WHERE userId = :userId AND nonogramId = :nonogramId), 0));

incrementBeat:
UPDATE UserProgress SET beat = beat + 1 WHERE userId = ? AND nonogramId = ?;

upsertProgressAfterWin:
INSERT OR REPLACE INTO UserProgress(userId, nonogramId, boardState, updatedAt, beat)
VALUES (:userId, :nonogramId, NULL, :updatedAt, COALESCE((SELECT beat FROM UserProgress WHERE userId = :userId AND nonogramId = :nonogramId), 0) + 1);

selectProgressForUser:
SELECT NonogramData.*, UserProgress.boardState, UserProgress.beat
FROM NonogramData
JOIN UserProgress ON UserProgress.nonogramId = NonogramData.id
WHERE UserProgress.userId = ?;

insertUser:
INSERT INTO User(id, name) VALUES (NULL, ?);

lastInsertedId:
SELECT last_insert_rowid();

selectUserById:
SELECT User.* FROM User WHERE id = ?;

selectUserByFirebaseUid:
SELECT User.* FROM User WHERE firebaseUid = ?;

updateUserFirebaseUid:
UPDATE User SET firebaseUid = ?, name = ? WHERE id = ?;

selectProgressForUserWithTimestamp:
SELECT UserProgress.nonogramId, UserProgress.boardState, UserProgress.updatedAt
FROM UserProgress
WHERE UserProgress.userId = ?;

selectSingleProgress:
SELECT UserProgress.boardState, UserProgress.updatedAt
FROM UserProgress
WHERE UserProgress.userId = ? AND UserProgress.nonogramId = ?;
