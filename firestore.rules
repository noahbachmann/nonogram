rules_version = '2';

// Publish moderation lives here, not in the client: see docs/publish-moderation.md.
// Deploy with `firebase deploy --only firestore:rules`, or paste into the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isBanned(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
          && get(/databases/$(database)/documents/users/$(uid)).data.get('publishBanned', false) == true;
    }

    // Admin roster. A user may check their own membership; nobody writes it from a client.
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Denial streak and publish ban. Written only as part of an admin's decision.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();

      match /progress/{nonogramId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    match /nonograms/{nonogramId} {

      // Docs written before review existed carry no `publishStatus` field.
      function publishStatusOf(data) {
        return data.get('publishStatus', 'NONE');
      }

      function contentChanged() {
        return request.resource.data.solution != resource.data.solution
            || request.resource.data.get('name', null) != resource.data.get('name', null)
            || request.resource.data.difficulty != resource.data.difficulty;
      }

      function isAuthor() {
        return isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      }

      allow read: if isAdmin()
          || publishStatusOf(resource.data) == 'APPROVED'
          || (isSignedIn() && resource.data.authorUid == request.auth.uid);

      allow create: if isAdmin() || (
          isAuthor() && publishStatusOf(request.resource.data) == 'NONE'
      );

      allow update: if isAdmin() || (
          isAuthor()
          && resource.data.authorUid == request.auth.uid
          && (
            contentChanged()
              // An edit always revokes the verdict: the reviewer only ever approved that content.
              ? publishStatusOf(request.resource.data) == 'NONE'
              : (
                  // Unchanged content leaves the state alone, files one request, or flips the
                  // author's own visibility switch on an already-approved puzzle.
                  publishStatusOf(request.resource.data) == publishStatusOf(resource.data)
                  || (publishStatusOf(resource.data) == 'NONE'
                      && publishStatusOf(request.resource.data) == 'PENDING'
                      && !isBanned(request.auth.uid))
                  || (publishStatusOf(resource.data) in ['APPROVED', 'UNLISTED']
                      && publishStatusOf(request.resource.data) in ['APPROVED', 'UNLISTED'])
                )
          )
      );

      allow delete: if isAdmin();
    }
  }
}
